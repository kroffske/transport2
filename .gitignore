.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.idea/
.vscode/
*.iml

# Локальные модели, эксперименты и runtime evidence не входят в исходники.
/.local/
/artifacts/
/.tasks/**/artifacts/
/notebooks/.tasks/
/.locus/settings.json
/.locus/runtime/
/.locus-pi/runs/
/.locus-pi/logs/
/.locus-pi/workspaces/

# Локальные картографические тайлы большие и воспроизводятся отдельно от исходников.
/consumer/map/*.pmtiles

# Полная официальная раздача хранится локально, но не попадает в Git.
data/train/
data/test/
data/validate/
data/labels/
data/emulator/*.tar
